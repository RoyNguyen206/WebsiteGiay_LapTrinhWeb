@model Website_Giay.ViewModels.ProductListViewModel
@using System.Linq
@{
    ViewBag.Title = !string.IsNullOrEmpty(Model.SelectedCategory) ? Model.SelectedCategory
                  : (!string.IsNullOrEmpty(Model.SelectedBrand) ? Model.SelectedBrand
                  : (!string.IsNullOrEmpty(Model.SearchKeyword) ? "Tìm kiếm" : "Tất cả sản phẩm"));
    ViewBag.PageName = "products";
    ViewBag.IsSubPage = true;

    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 12;
    bool hasMore = currentPage * pageSize < Model.TotalItems;

    Func<string, string, string, string, string> u = (c, b, p, s) =>
        Url.Action("Index", "Product", new
        {
            category = c,
            brand = b,
            audience = Model.SelectedAudience,
            price = p,
            sort = s,
            search = Model.SearchKeyword
        });

    bool noiBat = string.IsNullOrEmpty(Model.SortBy) || Model.SortBy == "noi-bat";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/assets/css/pages/products.css")">
    <style>
        .filter-radio-pill {
            border: 1px solid #e2e8f0;
            background: #ffffff;
        }
        .filter-radio-pill:hover, .active-filter-pill {
            border-color: #f97316 !important;
            background-color: #fff7ed !important;
        }
    </style>
}

<!-- BREADCRUMB -->
<nav class="container mt-3 mb-2" aria-label="breadcrumb">
    <ol class="breadcrumb py-2 px-0 bg-transparent mb-0">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none text-secondary">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Product")" class="text-decoration-none text-secondary">Sản phẩm</a></li>
        @if (!string.IsNullOrEmpty(Model.SelectedCategory))
        {
            <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@Model.SelectedCategory</li>
        }
        else if (!string.IsNullOrEmpty(Model.SelectedBrand))
        {
            <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@Model.SelectedBrand</li>
        }
        else
        {
            <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Tất cả</li>
        }
    </ol>
</nav>

<section id="khu-san-pham" class="khu-san-pham pb-5">
    <div class="container">
        <!-- HEADER TIÊU ĐỀ TRANG -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <p class="chu-nho text-secondary mb-1">Cửa hàng</p>
                <h1 id="tieu-de-danh-sach-san-pham" class="fs-2 fw-bold text-dark mb-0">
                    @(!string.IsNullOrEmpty(Model.SelectedCategory) ? Model.SelectedCategory
                    : !string.IsNullOrEmpty(Model.SelectedBrand) ? Model.SelectedBrand
                    : !string.IsNullOrEmpty(Model.SearchKeyword) ? "Kết quả tìm kiếm: \"" + Model.SearchKeyword + "\""
                    : "Tất cả sản phẩm")
                </h1>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <span id="so-ket-qua" class="so-ket-qua text-secondary">@Model.TotalItems sản phẩm</span>
                <!-- Sort Select -->
                <select id="sap-xep-san-pham" class="form-select form-select-sm"
                        style="width: auto; min-height: 38px; border-radius: 8px;" onchange="location = this.value;">
                    <option value="@u(Model.SelectedCategory, Model.SelectedBrand, Model.PriceRange, null)" @(noiBat ? "selected" : "")>Sản phẩm nổi bật</option>
                    <option value="@u(Model.SelectedCategory, Model.SelectedBrand, Model.PriceRange, "gia-tang")" @(Model.SortBy == "gia-tang" ? "selected" : "")>Giá thấp đến cao</option>
                    <option value="@u(Model.SelectedCategory, Model.SelectedBrand, Model.PriceRange, "gia-giam")" @(Model.SortBy == "gia-giam" ? "selected" : "")>Giá cao đến thấp</option>
                    <option value="@u(Model.SelectedCategory, Model.SelectedBrand, Model.PriceRange, "giam-gia")" @(Model.SortBy == "giam-gia" ? "selected" : "")>Đang giảm giá</option>
                </select>
            </div>
        </div>

        <!-- BỐ CỤC 2 CỘT: TRÁI LỌC CỐ ĐỊNH, PHẢI HIỂN THỊ SẢN PHẨM -->
        <div class="row">
            <!-- CỘT TRÁI: BỘ LỌC CỐ ĐỊNH -->
            <aside class="col-lg-3 col-md-4 mb-4">
                @Html.Partial("_SidebarFilter", Model)
            </aside>

            <!-- CỘT PHẢI: LƯỚI SẢN PHẨM -->
            <main class="col-lg-9 col-md-8">
                @if (Model.Products != null && Model.Products.Any())
                {
                    var products = Model.Products.ToList();
                    <div id="luoi-san-pham" class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 g-lg-4">
                        @for (int i = 0; i < products.Count; i++)
                        {
                            if (currentPage > 1 && i == (currentPage - 1) * pageSize)
                            {
                                <div id="vi-tri-them" class="col-12 p-0 m-0" style="height:0;"></div>
                            }
                            @Html.Partial("_ProductCard", products[i])
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-white rounded-4 shadow-sm my-2 border">
                        <i class="bi bi-search fs-1 text-secondary d-block mb-3"></i>
                        <h4 class="fw-bold text-dark">Không tìm thấy sản phẩm nào</h4>
                        <p class="text-secondary mb-4">Vui lòng thử chọn tiêu chí tìm kiếm hoặc bộ lọc khác.</p>
                        <a href="@Url.Action("Index", "Product")" class="btn btn-dark px-4 py-2 rounded-pill fw-bold">Xem tất cả sản phẩm</a>
                    </div>
                }

                <!-- XEM THÊM PHÂN TRANG -->
                @if (hasMore)
                {
                    <div class="khung-xem-them mt-4 text-center">
                        <a id="nut-xem-them" class="btn btn-dark px-5 py-2 rounded-pill fw-bold"
                           href="@(Url.Action("Index", "Product", new { category = Model.SelectedCategory, brand = Model.SelectedBrand, audience = Model.SelectedAudience, price = Model.PriceRange, sort = Model.SortBy, search = Model.SearchKeyword, page = currentPage + 1 }) + "#vi-tri-them")">
                            Xem thêm sản phẩm
                        </a>
                    </div>
                }
            </main>
        </div>
    </div>
</section>
