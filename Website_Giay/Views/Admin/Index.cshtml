@model Website_Giay.ViewModels.AdminDashboardViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản trị hệ thống | SoleStyle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/base.css")">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/pages/admin.css")">
</head>
<body data-page="admin">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 d-none d-md-block sidebar py-4">
                <div class="text-center mb-4">
                    <h4 class="fw-bold">SoleStyle Admin</h4>
                    <span class="badge bg-danger">Hệ thống MVC</span>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a href="#" class="admin-nav-link active" data-target="dashboard-section">
                        <i class="bi bi-speedometer2 me-2"></i>Tổng quan
                    </a>
                    <a href="#" class="admin-nav-link" data-target="users-section">
                        <i class="bi bi-people me-2"></i>Quản lý tài khoản
                    </a>
                    <a href="#" class="admin-nav-link" data-target="products-section">
                        <i class="bi bi-box-seam me-2"></i>Quản lý sản phẩm
                    </a>
                    <a href="@Url.Action("Index", "Home")" class="admin-nav-link text-info">
                        <i class="bi bi-house me-2"></i>Về trang chủ shop
                    </a>
                    <hr class="text-secondary" />
                    <a href="@Url.Action("Logout", "Account")" class="text-danger ps-3">
                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                    </a>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-10 ms-sm-auto col-lg-10 main-content p-4">
                
                <!-- Quick Stats Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-xl-3">
                        <div class="card p-3 border-0 shadow-sm rounded-4 bg-primary text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-white-50">Tổng sản phẩm</small>
                                    <h3 class="fw-bold mb-0">@Model.TotalProducts</h3>
                                </div>
                                <i class="bi bi-box-seam fs-1 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card p-3 border-0 shadow-sm rounded-4 bg-success text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-white-50">Tổng đơn hàng</small>
                                    <h3 class="fw-bold mb-0">@Model.TotalOrders</h3>
                                </div>
                                <i class="bi bi-receipt fs-1 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card p-3 border-0 shadow-sm rounded-4 bg-warning text-dark">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-dark-50">Người dùng</small>
                                    <h3 class="fw-bold mb-0">@Model.TotalUsers</h3>
                                </div>
                                <i class="bi bi-people fs-1 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card p-3 border-0 shadow-sm rounded-4 bg-danger text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-white-50">Tổng doanh thu</small>
                                    <h3 class="fw-bold mb-0">@Model.TotalRevenue.ToString("N0")đ</h3>
                                </div>
                                <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 1: QUẢN LÝ TÀI KHOẢN -->
                <section id="users-section" class="admin-section">
                    <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
                        <h2 class="mb-0 fw-bold">Quản lý tài khoản (@Model.Users.Count)</h2>
                        <button id="openUserModalBtn" class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#userModal">
                            <i class="bi bi-plus-lg me-1"></i>Thêm tài khoản
                        </button>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Họ tên</th>
                                            <th>Email</th>
                                            <th>Số điện thoại</th>
                                            <th>Vai trò</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="userTableBody">
                                        @foreach (var u in Model.Users)
                                        {
                                            <tr id="user-row-@u.UserId">
                                                <td>@u.UserId</td>
                                                <td><strong>@u.FullName</strong></td>
                                                <td>@u.Email</td>
                                                <td>@(string.IsNullOrEmpty(u.PhoneNumber) ? "---" : u.PhoneNumber)</td>
                                                <td>
                                                    <span class="badge @(u.Role == "Admin" ? "bg-danger" : "bg-primary")">@u.Role</span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="xoaNguoiDung(@u.UserId)">
                                                        <i class="bi bi-trash"></i> Xóa
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- SECTION 2: QUẢN LÝ SẢN PHẨM -->
                <section id="products-section" class="admin-section d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
                        <h2 class="mb-0 fw-bold">Quản lý sản phẩm (@Model.Products.Count)</h2>
                        <button id="openProductModalBtn" class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#productModal">
                            <i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm
                        </button>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Hình ảnh</th>
                                            <th>Tên sản phẩm</th>
                                            <th>Thương hiệu</th>
                                            <th>Danh mục</th>
                                            <th>Giá bán</th>
                                            <th>Tồn kho</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="productTableBody">
                                        @foreach (var p in Model.Products)
                                        {
                                            <tr id="prod-row-@p.Id">
                                                <td>#@p.Id</td>
                                                <td>
                                                    <img src="@Url.Content(p.ImageUrl ?? "~/assets/img/default.png")" alt="@p.Name" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("Detail", "Product", new { id = p.Id })" target="_blank" class="fw-bold text-dark text-decoration-none">
                                                        @p.Name
                                                    </a>
                                                </td>
                                                <td><span class="badge bg-secondary">@p.BrandName</span></td>
                                                <td>@p.CategoryName</td>
                                                <td><strong class="text-danger">@p.Price.ToString("N0")đ</strong></td>
                                                <td>@p.Stock</td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="xoaSanPham(@p.Id)">
                                                        <i class="bi bi-trash"></i> Xóa
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <!-- Modals -->
    <div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="userForm">
                    <div class="modal-header">
                        <h5 class="modal-title">Thêm tài khoản mới</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Họ tên</label>
                            <input type="text" class="form-control" id="userName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" id="userEmail" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input type="tel" class="form-control" id="userPhone" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control" id="userPassword" minlength="5" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar tab switching
        document.querySelectorAll(".admin-nav-link").forEach(link => {
            link.addEventListener("click", function (e) {
                const target = this.getAttribute("data-target");
                if (!target) return;
                e.preventDefault();
                document.querySelectorAll(".admin-nav-link").forEach(l => l.classList.remove("active"));
                this.classList.add("active");

                if (target === "dashboard-section" || target === "users-section") {
                    document.getElementById("users-section").classList.remove("d-none");
                    document.getElementById("products-section").classList.add("d-none");
                } else if (target === "products-section") {
                    document.getElementById("products-section").classList.remove("d-none");
                    document.getElementById("users-section").classList.add("d-none");
                }
            });
        });

        function xoaSanPham(id) {
            if (!confirm(`Bạn có chắc muốn xóa sản phẩm #${id}?`)) return;
            fetch("@Url.Action("DeleteProduct", "Admin")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `id=${id}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = document.getElementById(`prod-row-${id}`);
                    if (row) row.remove();
                    alert("Đã xóa sản phẩm thành công!");
                } else {
                    alert(data.message || "Không thể xóa sản phẩm.");
                }
            });
        }

        function xoaNguoiDung(id) {
            if (!confirm(`Bạn có chắc muốn xóa người dùng #${id}?`)) return;
            fetch("@Url.Action("DeleteUser", "Admin")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `id=${id}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = document.getElementById(`user-row-${id}`);
                    if (row) row.remove();
                    alert("Đã xóa người dùng thành công!");
                } else {
                    alert(data.message || "Không thể xóa người dùng.");
                }
            });
        }
    </script>
</body>
</html>
