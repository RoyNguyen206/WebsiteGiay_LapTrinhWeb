@model Website_Giay.ViewModels.ProductItemViewModel
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " - " : "")SoleStyle - Cửa hàng giày sneaker chính hãng</title>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- CSS Theme -->
    <link rel="stylesheet" href="@Url.Content(" ~ /assets/css/base.css")">
    <link rel="stylesheet" href="@Url.Content(" ~ /assets/css/components/header.css")">
    <link rel="stylesheet" href="@Url.Content(" ~ /assets/css/components/footer.css")">
    <link rel="stylesheet" href="@Url.Content(" ~ /assets/css/components/breadcrumb.css")">
</head>
<div class="col">
    <div class="card h-100 border-0 shadow-sm rounded-4 position-relative p-2 product-card-grid"
         style="background: #ffffff; border: 1px solid #f1f5f9; transition: transform 0.2s, box-shadow 0.2s;"
         data-ma-san-pham="@Model.Id">

        <!-- Badge Giảm giá / NEW -->
        @if (!string.IsNullOrEmpty(Model.Badge))
        {
            <span class="badge bg-dark position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill z-2 text-uppercase" style="font-size: 11px; font-weight: 700;">@Model.Badge</span>
        }
        else if (Model.HasDiscount)
        {
            <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill z-2" style="font-size: 11px; font-weight: 700;">-@Model.DiscountPercent%</span>
        }

        <!-- Nút tim Yêu thích -->
        <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 p-1 shadow-sm border z-2 d-flex align-items-center justify-content-center"
                style="width: 34px; height: 34px; background: #ffffff; border-color: #e2e8f0;"
                type="button"
                aria-label="Yêu thích">
            <i class="bi bi-heart text-secondary" style="font-size: 14px;"></i>
        </button>

        <!-- Khung chứa ảnh (Nền xám bo góc chuẩn) -->
        <div class="rounded-4 p-3 text-center position-relative mb-2 d-flex align-items-center justify-content-center overflow-hidden"
             style="background-color: #f8fafc; height: 230px;">
            <a href="@Url.Action("Detail", "Product", new { id = Model.Id })" class="w-100 h-100 d-flex align-items-center justify-content-center">
                <img src="@Url.Content(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "~/assets/img/image (4).png")"
                     alt="@Model.Name"
                     class="img-fluid object-fit-contain"
                     style="max-height: 190px; width: auto; transition: transform 0.3s ease;"
                     loading="lazy">
            </a>
        </div>

        <!-- Thân Card thông tin sản phẩm -->
        <div class="card-body d-flex flex-column p-2 pt-1">
            <!-- Thương hiệu & Phân loại -->
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.5px;">@(Model.BrandName ?? "SoleStyle")</span>
                @if (!string.IsNullOrEmpty(Model.CategoryName))
                {
                    <span class="badge bg-info-subtle text-info fw-bold" style="font-size: 10px;">@Model.CategoryName</span>
                }
            </div>

            <!-- Tên sản phẩm -->
            <h6 class="card-title fw-bold text-dark text-truncate mb-1" title="@Model.Name">
                <a href="@Url.Action("Detail", "Product", new { id = Model.Id })" class="text-decoration-none text-dark">
                    @Model.Name
                </a>
            </h6>

            <!-- Đánh giá sao & Đã bán -->
            <div class="d-flex align-items-center gap-1 mb-2" style="font-size: 12px;">
                <i class="bi bi-star-fill text-warning"></i>
                <span class="fw-bold text-dark">@(Model.Rating > 0 ? Model.Rating.ToString("0.0") : "4.9")</span>
                <span class="text-muted">(@Model.ReviewCount đánh giá)</span>
            </div>

            <!-- Tồn kho -->
            <div class="small text-muted mb-2" style="font-size: 11px;">
                @(Model.Stock > 0 ? $"{Model.Stock} sản phẩm còn hàng" : "Tạm hết hàng")
            </div>

            <!-- Giá & Nút hành động Mua ngay màu cam -->
            <div class="mt-auto pt-2 border-top d-flex flex-column gap-2">
                <div class="d-flex align-items-baseline gap-2">
                    <strong class="text-danger fw-bold fs-5 mb-0">@Model.Price.ToString("N0")đ</strong>
                    @if (Model.OldPrice > Model.Price && Model.OldPrice > 0)
                    {
                        <del class="text-muted small">@Model.OldPrice.ToString("N0")đ</del>
                    }
                </div>

                <div class="d-flex gap-2 mt-1">
                    <button class="btn btn-light border rounded-circle p-2 d-flex align-items-center justify-content-center nut-gio-card"
                            data-ma-san-pham="@Model.Id"
                            style="width: 40px; height: 40px;"
                            type="button"
                            @(Model.Stock == 0 ? "disabled" : "")
                            title="Thêm vào giỏ">
                        <i class="bi bi-bag-plus fs-6 text-dark"></i>
                    </button>

                    <a href="@(Model.Stock == 0 ? "#" : Url.Action("Detail", "Product", new { id = Model.Id }))"
                       class="btn text-white fw-bold flex-grow-1 d-flex align-items-center justify-content-center rounded-3 nut-mua-ngay-card @(Model.Stock == 0 ? "disabled" : "")"
                       style="background-color: #ff7a32; border: none; height: 40px; font-size: 14px;">
                        Mua ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>