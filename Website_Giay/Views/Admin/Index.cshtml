        }

        document.getElementById("websiteSettingsForm").addEventListener("submit", function(e) {
            e.preventDefault();
            const storeName = document.getElementById("settingStoreName").value;
            const hotline = document.getElementById("settingHotline").value;
            const email = document.getElementById("settingEmail").value;
            const address = document.getElementById("settingAddress").value;
            const freeship = document.getElementById("settingFreeShip").value;
            const isOpen = document.getElementById("settingIsOpen").value;
            const announce = document.getElementById("settingAnnouncement").value;

            const params = `StoreName=${encodeURIComponent(storeName)}&Hotline=${encodeURIComponent(hotline)}&Email=${encodeURIComponent(email)}&Address=${encodeURIComponent(address)}&FreeShippingThreshold=${freeship}&IsStoreOpen=${isOpen}&Announcement=${encodeURIComponent(announce)}`;

            fetch("@Url.Action("SaveWebsiteSettings", "Admin")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: params
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
            });
        });
    </script>
</body>
</html>
