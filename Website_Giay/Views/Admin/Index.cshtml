@model Website_Giay.ViewModels.AdminDashboardViewModel
@{
    Layout = null;
    ViewBag.Title = "SoleStyle Admin";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoleStyle Admin - Hệ thống Quản trị</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/base.css")">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/pages/admin.css")">
    <style>
        body {
            background-color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .sidebar {
            min-height: 100vh;
            background-color: #1e293b;
            color: #f8fafc;
            padding: 0;
            box-shadow: 2px 0 10px rgba(0,0,0,0.05);
        }
        .sidebar-brand {
            padding: 22px 20px 18px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            text-align: center;
        }
        .sidebar-heading {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #94a3b8;
            padding: 16px 20px 6px 20px;
            margin-bottom: 2px;
        }
        .admin-nav-link {
            color: #cbd5e1;
            text-decoration: none;
            padding: 9px 18px;
            display: flex;
            align-items: center;
            border-radius: 8px;
            margin: 2px 12px;
            transition: all 0.2s ease;
            font-size: 0.88rem;
            font-weight: 500;
        }
        .admin-nav-link i {
            font-size: 1.1rem;
            margin-right: 12px;
            width: 20px;
            text-align: center;
        }
        .admin-nav-link:hover {
            background-color: rgba(255,255,255,0.08);
            color: #ffffff;
        }
        .admin-nav-link.active {
            background-color: #0d6efd;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(13,110,253,0.3);
        }
        .main-content {
            padding: 28px;
            min-height: 100vh;
        }
        .stat-card {
            border: none;
            border-radius: 16px;
            transition: transform 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-3px);
        }
        .table-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.04);
            overflow: hidden;
            background: #ffffff;
        }
        .badge-pending {
            background-color: #ffc107;
            color: #000;
        }
        .badge-shipping {
            background-color: #0dcaf0;
            color: #000;
        }
        .badge-completed {
            background-color: #198754;
            color: #fff;
        }
        .badge-cancelled {
            background-color: #dc3545;
            color: #fff;
        }
        .order-product-thumb {
            width: 44px;
            height: 44px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }
    </style>
</head>
<body data-page="admin">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- SIDEBAR -->
            <nav class="col-md-3 col-lg-2 d-none d-md-block sidebar py-3">
                <div class="sidebar-brand">
                    <h4 class="fw-bold mb-1 text-white">SoleStyle</h4>
                    <span class="badge bg-primary px-3 py-1">Hệ thống MVC</span>
                </div>

                <div class="py-2">
                    <!-- TỔNG QUAN -->
                    <div class="sidebar-heading">TỔNG QUAN</div>
                    <a href="#" class="admin-nav-link active" data-target="overview-section">
                        <i class="bi bi-speedometer2"></i>Tổng quan hệ thống
                    </a>

                    <!-- KINH DOANH -->
                    <div class="sidebar-heading">KINH DOANH</div>
                    <a href="#" class="admin-nav-link" data-target="orders-section">
                        <i class="bi bi-receipt"></i>Quản lý đơn hàng
                        @if (Model.PendingOrdersCount > 0)
                        {
                            <span class="badge bg-warning text-dark ms-auto">@Model.PendingOrdersCount</span>
                        }
                    </a>
                    <a href="#" class="admin-nav-link" data-target="users-section">
                        <i class="bi bi-people"></i>Quản lý tài khoản
                    </a>
                    <a href="#" class="admin-nav-link" data-target="reviews-section">
                        <i class="bi bi-star"></i>Quản lý đánh giá
                    </a>

                    <!-- SẢN PHẨM & KHO -->
                    <div class="sidebar-heading">SẢN PHẨM & KHO</div>
                    <a href="#" class="admin-nav-link" data-target="products-section">
                        <i class="bi bi-box-seam"></i>Quản lý sản phẩm
                    </a>
                    <a href="#" class="admin-nav-link" data-target="inventory-section">
                        <i class="bi bi-archive"></i>Quản lý kho hàng
                        @if (Model.LowStockCount > 0)
                        {
                            <span class="badge bg-danger ms-auto">@Model.LowStockCount</span>
                        }
                    </a>
                    <a href="#" class="admin-nav-link" data-target="categories-brands-section">
                        <i class="bi bi-tags"></i>Danh mục & Thương hiệu
                    </a>

                    <!-- MARKETING -->
                    <div class="sidebar-heading">MARKETING</div>
                    <a href="@Url.Action("Index", "AdminPromotion")" class="admin-nav-link">
                        <i class="bi bi-calendar-event"></i>Quản lý sự kiện
                    </a>
                    <a href="#" class="admin-nav-link" data-target="discounts-section">
                        <i class="bi bi-ticket-perforated"></i>Mã giảm giá
                    </a>
                    <a href="#" class="admin-nav-link" data-target="banners-section">
                        <i class="bi bi-images"></i>Banner trang chủ
                    </a>

                    <!-- HỆ THỐNG & BÁO CÁO -->
                    <div class="sidebar-heading">HỆ THỐNG & BÁO CÁO</div>
                    <a href="#" class="admin-nav-link" data-target="revenue-section">
                        <i class="bi bi-graph-up-arrow"></i>Thống kê doanh thu
                    </a>
                    <a href="#" class="admin-nav-link" data-target="contacts-section">
                        <i class="bi bi-envelope"></i>Quản lý liên hệ
                    </a>
                    <a href="#" class="admin-nav-link" data-target="settings-section">
                        <i class="bi bi-gear"></i>Cài đặt website
                    </a>

                    <hr class="mx-3 my-3 border-secondary" />
                    <a href="@Url.Action("Index", "Home")" class="admin-nav-link text-info">
                        <i class="bi bi-house"></i>Về trang chủ shop
                    </a>
                    <a href="@Url.Action("Logout", "Account")" class="admin-nav-link text-danger">
                        <i class="bi bi-box-arrow-right"></i>Đăng xuất
                    </a>
                </div>
            </nav>

            <!-- MAIN CONTENT -->
            <main class="col-md-9 ms-sm-auto col-lg-10 main-content">

                <!-- TAB 1: TỔNG QUAN (UI THỐNG KÊ & BÁO CÁO) -->
                <section id="overview-section" class="admin-tab-content">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Tổng quan hệ thống</h2>
                            <p class="text-muted mb-0">Thống kê hoạt động kinh doanh và vận hành SoleStyle</p>
                        </div>
                        <button class="btn btn-outline-primary" onclick="location.reload()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
                        </button>
                    </div>

                    <!-- 4 Thẻ KPI chính -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6 col-xl-3">
                            <div class="card p-3 stat-card shadow-sm bg-primary text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-white-50">Tổng doanh thu</small>
                                        <h3 class="fw-bold mb-0">@Model.TotalRevenue.ToString("N0")đ</h3>
                                    </div>
                                    <i class="bi bi-cash-stack fs-1 opacity-75"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xl-3">
                            <div class="card p-3 stat-card shadow-sm bg-success text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-white-50">Tổng đơn hàng</small>
                                        <h3 class="fw-bold mb-0">@Model.TotalOrders</h3>
                                    </div>
                                    <i class="bi bi-bag-check fs-1 opacity-75"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xl-3">
                            <div class="card p-3 stat-card shadow-sm bg-warning text-dark">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-dark-50">Sản phẩm sắp hết hàng</small>
                                        <h3 class="fw-bold mb-0">@Model.LowStockCount</h3>
                                    </div>
                                    <i class="bi bi-exclamation-triangle fs-1 opacity-75"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xl-3">
                            <div class="card p-3 stat-card shadow-sm bg-info text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-white-50">Khách hàng & User</small>
                                        <h3 class="fw-bold mb-0">@Model.TotalUsers</h3>
                                    </div>
                                    <i class="bi bi-people fs-1 opacity-75"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hai khối: Đơn hàng mới & Top sản phẩm -->
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <div class="card table-card p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Đơn hàng gần đây</h5>
                                    <a href="#" class="btn btn-sm btn-outline-primary" onclick="switchTab('orders-section')">Xem tất cả</a>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Mã</th>
                                                <th>Khách hàng</th>
                                                <th>Tổng tiền</th>
                                                <th>Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var o in Model.Orders.Take(5))
                                            {
                                                <tr>
                                                    <td><strong>#@o.OrderId</strong></td>
                                                    <td>
                                                        <div>@o.CustomerName</div>
                                                        <small class="text-muted">@o.CustomerPhone</small>
                                                    </td>
                                                    <td class="text-danger fw-bold">@o.TotalAmount.ToString("N0")đ</td>
                                                    <td>
                                                        @if (o.OrderStatus == "Đã giao")
                                                        {
                                                            <span class="badge badge-completed">Đã giao</span>
                                                        }
                                                        else if (o.OrderStatus == "Đang giao")
                                                        {
                                                            <span class="badge badge-shipping">Đang giao</span>
                                                        }
                                                        else if (o.OrderStatus == "Đã hủy")
                                                        {
                                                            <span class="badge badge-cancelled">Đã hủy</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-pending">Đang xử lý</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="card table-card p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0"><i class="bi bi-trophy me-2 text-warning"></i>Sản phẩm bán chạy</h5>
                                    <a href="#" class="btn btn-sm btn-outline-primary" onclick="switchTab('products-section')">Xem kho</a>
                                </div>
                                <div class="table-responsive">
                                    <table class="table align-middle mb-0">
                                        <tbody>
                                            @foreach (var p in Model.TopSellingProducts)
                                            {
                                                <tr>
                                                    <td style="width: 50px;">
                                                        <img src="@Url.Content(p.ImageUrl ?? "~/assets/img/default.png")" class="rounded" style="width: 44px; height: 44px; object-fit: cover;">
                                                    </td>
                                                    <td>
                                                        <div class="fw-semibold text-truncate" style="max-width: 180px;">@p.ProductName</div>
                                                        <small class="text-muted">@p.BrandName</small>
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="fw-bold text-success">@p.TotalSold đôi</div>
                                                        <small class="text-muted">@p.Price.ToString("N0")đ</small>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 2: QUẢN LÝ ĐƠN HÀNG (STT 1) -->
                <section id="orders-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Quản lý đơn hàng (@Model.Orders.Count)</h2>
                            <p class="text-muted mb-0">Xem chi tiết đơn mua, duyệt trạng thái và xử lý giao nhận</p>
                        </div>
                    </div>

                    <div class="card table-card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Mã ĐH</th>
                                            <th>Ngày đặt</th>
                                            <th>Khách hàng</th>
                                            <th>Chi tiết sản phẩm mua</th>
                                            <th>Tổng tiền</th>
                                            <th>Trạng thái</th>
                                            <th class="text-center">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var o in Model.Orders)
                                        {
                                            <tr id="order-row-@o.OrderId">
                                                <td><strong>#@o.OrderId</strong></td>
                                                <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>
                                                    <strong>@o.CustomerName</strong><br />
                                                    <small class="text-muted">@o.CustomerPhone</small><br />
                                                    <small class="text-secondary">@o.ShippingAddress</small>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column gap-2" style="max-width: 320px;">
                                                        @foreach (var item in o.Details)
                                                        {
                                                            <div class="d-flex align-items-center gap-2 bg-light p-1 rounded">
                                                                <img src="@Url.Content(item.ImageUrl ?? "~/assets/img/default.png")" class="order-product-thumb" />
                                                                <div class="small">
                                                                    <div class="fw-bold text-truncate" style="max-width: 220px;">@item.ProductName</div>
                                                                    <span class="text-muted">Size: @item.SelectedSize | Màu: @item.SelectedColor | SL: <strong>@item.Quantity</strong></span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td><span class="text-danger fw-bold fs-6">@o.TotalAmount.ToString("N0")đ</span></td>
                                                <td>
                                                    <select class="form-select form-select-sm" id="status-select-@o.OrderId" style="width: 140px;">
                                                        <option value="Đang xử lý" @(o.OrderStatus == "Đang xử lý" ? "selected" : "")>Đang xử lý</option>
                                                        <option value="Đang giao" @(o.OrderStatus == "Đang giao" ? "selected" : "")>Đang giao</option>
                                                        <option value="Đã giao" @(o.OrderStatus == "Đã giao" ? "selected" : "")>Đã giao</option>
                                                        <option value="Đã hủy" @(o.OrderStatus == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                                                    </select>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary" onclick="capNhatTrangThaiDonHang(@o.OrderId)">
                                                            <i class="bi bi-check2"></i> Lưu
                                                        </button>
                                                        <button class="btn btn-outline-danger" onclick="xoaDonHang(@o.OrderId)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 3: QUẢN LÝ TÀI KHOẢN -->
                <section id="users-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Quản lý tài khoản (@Model.Users.Count)</h2>
                            <p class="text-muted mb-0">Danh sách người dùng và phân quyền hệ thống</p>
                        </div>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#userModal">
                            <i class="bi bi-person-plus me-1"></i>Thêm tài khoản
                        </button>
                    </div>

                    <div class="card table-card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Họ tên</th>
                                            <th>Email</th>
                                            <th>Số điện thoại</th>
                                            <th>Địa chỉ</th>
                                            <th>Vai trò</th>
                                            <th>Ngày tạo</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var u in Model.Users)
                                        {
                                            <tr id="user-row-@u.UserId">
                                                <td>@u.UserId</td>
                                                <td><strong>@u.FullName</strong></td>
                                                <td>@u.Email</td>
                                                <td>@(string.IsNullOrEmpty(u.PhoneNumber) ? "---" : u.PhoneNumber)</td>
                                                <td>@(string.IsNullOrEmpty(u.Address) ? "---" : u.Address)</td>
                                                <td>
                                                    <span class="badge @(u.Role == "Admin" ? "bg-danger" : "bg-primary")">@u.Role</span>
                                                </td>
                                                <td>@u.CreatedDate.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="xoaNguoiDung(@u.UserId)">
                                                        <i class="bi bi-trash"></i> Xóa
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 4: QUẢN LÝ ĐÁNH GIÁ (STT 6) -->
                <section id="reviews-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Quản lý đánh giá (@Model.Reviews.Count)</h2>
                            <p class="text-muted mb-0">Duyệt, ẩn hoặc xóa các bình luận đánh giá của khách hàng</p>
                        </div>
                    </div>

                    <div class="card table-card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Khách hàng</th>
                                            <th>Sản phẩm</th>
                                            <th>Đánh giá</th>
                                            <th>Nội dung bình luận</th>
                                            <th>Ngày gửi</th>
                                            <th>Trạng thái</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.Reviews)
                                        {
                                            <tr id="review-row-@r.ReviewId">
                                                <td>#@r.ReviewId</td>
                                                <td><strong>@r.CustomerName</strong></td>
                                                <td class="text-primary fw-semibold">@r.ProductName</td>
                                                <td>
                                                    @for (int i = 0; i < r.Rating; i++)
                                                    {
                                                        <i class="bi bi-star-fill text-warning"></i>
                                                    }
                                                </td>
                                                <td>@r.Comment</td>
                                                <td>@r.CreatedDate.ToString("dd/MM/yyyy")</td>
                                                <td id="review-status-@r.ReviewId">
                                                    @if (r.IsApproved)
                                                    {
                                                        <span class="badge bg-success">Đã duyệt</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Đã ẩn / Chờ duyệt</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-success me-1" onclick="toggleReview(@r.ReviewId, true)">
                                                        <i class="bi bi-check-lg"></i> Duyệt
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="toggleReview(@r.ReviewId, false)">
                                                        <i class="bi bi-eye-slash"></i> Ẩn
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="xoaReview(@r.ReviewId)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 5: QUẢN LÝ SẢN PHẨM -->
                <section id="products-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Quản lý sản phẩm (@Model.Products.Count)</h2>
                            <p class="text-muted mb-0">Thêm mới, cập nhật giá bán và điều chỉnh danh sách sản phẩm</p>
                        </div>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productModal">
                            <i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm
                        </button>
                    </div>

                    <div class="card table-card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Hình ảnh</th>
                                            <th>Tên sản phẩm</th>
                                            <th>Thương hiệu</th>
                                            <th>Danh mục</th>
                                            <th>Giá bán</th>
                                            <th>Tồn kho</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Model.Products)
                                        {
                                            <tr id="prod-row-@p.Id">
                                                <td>#@p.Id</td>
                                                <td>
                                                    <img src="@Url.Content(p.ImageUrl ?? "~/assets/img/default.png")" alt="@p.Name" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("Detail", "Product", new { id = p.Id })" target="_blank" class="fw-bold text-dark text-decoration-none">
                                                        @p.Name
                                                    </a>
                                                </td>
                                                <td><span class="badge bg-secondary">@p.BrandName</span></td>
                                                <td>@p.CategoryName</td>
                                                <td><strong class="text-danger">@p.Price.ToString("N0")đ</strong></td>
                                                <td>@p.Stock</td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="xoaSanPham(@p.Id)">
                                                        <i class="bi bi-trash"></i> Xóa
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 6: QUẢN LÝ KHO HÀNG (STT 2) -->
                <section id="inventory-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Quản lý kho hàng & Cảnh báo tồn</h2>
                            <p class="text-muted mb-0">Kiểm soát số lượng tồn kho theo sản phẩm và cập nhật nhanh tại chỗ</p>
                        </div>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center mb-4">
                        <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                        <div>
                            <strong>Cảnh báo tự động:</strong> Có <strong>@Model.LowStockCount</strong> sản phẩm có lượng tồn kho dưới hoặc bằng 10 chiếc cần nhập thêm hàng.
                        </div>
                    </div>

                    <div class="card table-card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Mã SP</th>
                                            <th>Hình ảnh</th>
                                            <th>Tên sản phẩm</th>
                                            <th>Thương hiệu</th>
                                            <th>Danh mục</th>
                                            <th>Tồn kho hiện tại</th>
                                            <th>Tình trạng</th>
                                            <th>Cập nhật số lượng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.InventoryItems)
                                        {
                                            <tr id="inv-row-@item.ProductId">
                                                <td>#@item.ProductId</td>
                                                <td>
                                                    <img src="@Url.Content(item.ImageUrl ?? "~/assets/img/default.png")" class="rounded" style="width: 44px; height: 44px; object-fit: cover;">
                                                </td>
                                                <td><strong>@item.ProductName</strong></td>
                                                <td>@item.BrandName</td>
                                                <td>@item.CategoryName</td>
                                                <td id="inv-stock-val-@item.ProductId" class="fw-bold fs-6">@item.Stock</td>
                                                <td id="inv-badge-@item.ProductId">
                                                    @if (item.Stock == 0)
                                                    {
                                                        <span class="badge bg-danger">Hết hàng</span>
                                                    }
                                                    else if (item.IsLowStock)
                                                    {
                                                        <span class="badge bg-warning text-dark"><i class="bi bi-bell-fill me-1"></i>Sắp hết hàng</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">Còn hàng</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="input-group input-group-sm" style="max-width: 170px;">
                                                        <input type="number" class="form-control" id="inv-input-@item.ProductId" value="@item.Stock" min="0">
                                                        <button class="btn btn-outline-primary" onclick="capNhatTonKho(@item.ProductId)">
                                                            Lưu
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 7: DANH MỤC & THƯƠNG HIỆU (STT 3 & 4) -->
                <section id="categories-brands-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Danh mục & Thương hiệu</h2>
                            <p class="text-muted mb-0">Quản lý nhóm phân loại và thương hiệu phân phối chính hãng</p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Danh mục (Categories) -->
                        <div class="col-lg-6">
                            <div class="card table-card p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0">Danh mục sản phẩm (@Model.Categories.Count)</h5>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#categoryModal">
                                        <i class="bi bi-plus-lg me-1"></i>Thêm danh mục
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>ID</th>
                                                <th>Tên danh mục</th>
                                                <th>Slug</th>
                                                <th>Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in Model.Categories)
                                            {
                                                <tr id="cat-row-@c.CategoryId">
                                                    <td>@c.CategoryId</td>
                                                    <td><strong>@c.CategoryName</strong></td>
                                                    <td><code>@c.Slug</code></td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-danger" onclick="xoaDanhMuc(@c.CategoryId)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Thương hiệu (Brands) -->
                        <div class="col-lg-6">
                            <div class="card table-card p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0">Thương hiệu giày (@Model.Brands.Count)</h5>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#brandModal">
                                        <i class="bi bi-plus-lg me-1"></i>Thêm thương hiệu
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>ID</th>
                                                <th>Logo</th>
                                                <th>Tên thương hiệu</th>
                                                <th>Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var b in Model.Brands)
                                            {
                                                <tr id="brand-row-@b.BrandId">
                                                    <td>@b.BrandId</td>
                                                    <td>
                                                        <img src="@Url.Content(b.LogoUrl ?? "~/assets/img/default.png")" class="rounded" style="width: 36px; height: 36px; object-fit: contain;">
                                                    </td>
                                                    <td><strong>@b.BrandName</strong></td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-danger" onclick="xoaThuongHieu(@b.BrandId)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 8: MÃ GIẢM GIÁ (STT 5) -->
                <section id="discounts-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Quản lý mã giảm giá (Vouchers)</h2>
                            <p class="text-muted mb-0">Tạo mã ưu đãi, giới hạn số lần sử dụng và thời gian áp dụng</p>
                        </div>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#discountModal">
                            <i class="bi bi-plus-lg me-1"></i>Tạo mã mới
                        </button>
                    </div>

                    <div class="card table-card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Mã Voucher</th>
                                            <th>Mức giảm</th>
                                            <th>Đã dùng / Giới hạn</th>
                                            <th>Ngày hết hạn</th>
                                            <th>Trạng thái</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.Discounts)
                                        {
                                            <tr id="discount-row-@d.DiscountId">
                                                <td>#@d.DiscountId</td>
                                                <td><span class="badge bg-light text-primary border border-primary fs-6">@d.Code</span></td>
                                                <td class="fw-bold text-success">
                                                    @(d.DiscountPercent > 0 ? (d.DiscountPercent + "%") : (d.DiscountAmount.ToString("N0") + "đ"))
                                                </td>
                                                <td>@d.UsedCount / @d.UsageLimit lượt</td>
                                                <td>@d.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    @if (d.IsActive && d.ExpiryDate >= DateTime.Now)
                                                    {
                                                        <span class="badge bg-success">Đang kích hoạt</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Hết hạn / Khóa</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="xoaMaGiamGia(@d.DiscountId)">
                                                        <i class="bi bi-trash"></i> Xóa
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 9: BANNER TRANG CHỦ -->
                <section id="banners-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Banner trang chủ</h2>
                            <p class="text-muted mb-0">Cấu hình các slide hình ảnh và liên kết quảng bá nổi bật</p>
                        </div>
                    </div>

                    <div class="card table-card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Hình ảnh</th>
                                            <th>Tiêu đề banner</th>
                                            <th>Phụ đề</th>
                                            <th>Liên kết đích</th>
                                            <th>Thứ tự</th>
                                            <th>Trạng thái</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var b in Model.Banners)
                                        {
                                            <tr id="banner-row-@b.BannerId">
                                                <td>#@b.BannerId</td>
                                                <td>
                                                    <img src="@Url.Content(b.ImageUrl)" class="rounded shadow-sm" style="width: 80px; height: 50px; object-fit: cover;">
                                                </td>
                                                <td><strong>@b.Title</strong></td>
                                                <td class="text-muted">@b.SubTitle</td>
                                                <td><code>@b.LinkUrl</code></td>
                                                <td>@b.DisplayOrder</td>
                                                <td id="banner-status-@b.BannerId">
                                                    @if (b.IsActive)
                                                    {
                                                        <span class="badge bg-success">Hiển thị</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Tắt</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary" onclick="toggleBanner(@b.BannerId)">
                                                        Bật / Tắt
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 10: THỐNG KÊ DOANH THU (STT 7) -->
                <section id="revenue-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Báo cáo & Thống kê doanh thu</h2>
                            <p class="text-muted mb-0">Chi tiết nguồn thu, giá trị trung bình đơn và hiệu suất bán hàng</p>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <div class="card p-4 table-card text-center">
                                <small class="text-muted text-uppercase fw-semibold">Tổng doanh thu thực tế</small>
                                <h3 class="fw-bold text-success mt-2 mb-0">@Model.TotalRevenue.ToString("N0")đ</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card p-4 table-card text-center">
                                <small class="text-muted text-uppercase fw-semibold">Tổng số đơn hàng</small>
                                <h3 class="fw-bold text-primary mt-2 mb-0">@Model.TotalOrders đơn</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card p-4 table-card text-center">
                                <small class="text-muted text-uppercase fw-semibold">Giá trị trung bình / đơn</small>
                                <h3 class="fw-bold text-info mt-2 mb-0">
                                    @((Model.TotalOrders > 0 ? (Model.TotalRevenue / Model.TotalOrders) : 0).ToString("N0"))đ
                                </h3>
                            </div>
                        </div>
                    </div>

                    <div class="card table-card p-4">
                        <h5 class="fw-bold mb-3">Tỷ lệ trạng thái đơn hàng</h5>
                        @{
                            int completedOrders = Model.Orders.Count(o => o.OrderStatus == "Đã giao");
                            int pendingOrders = Model.Orders.Count(o => o.OrderStatus == "Đang xử lý");
                            int shippingOrders = Model.Orders.Count(o => o.OrderStatus == "Đang giao");
                            int cancelledOrders = Model.Orders.Count(o => o.OrderStatus == "Đã hủy");
                            int totalO = Math.Max(1, Model.TotalOrders);
                        }
                        <div class="progress mb-4" style="height: 25px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @(completedOrders * 100 / totalO)%;">Đã giao (@completedOrders)</div>
                            <div class="progress-bar bg-warning text-dark" role="progressbar" style="width: @(pendingOrders * 100 / totalO)%;">Đang xử lý (@pendingOrders)</div>
                            <div class="progress-bar bg-info text-dark" role="progressbar" style="width: @(shippingOrders * 100 / totalO)%;">Đang giao (@shippingOrders)</div>
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @(cancelledOrders * 100 / totalO)%;">Đã hủy (@cancelledOrders)</div>
                        </div>

                        <h5 class="fw-bold mb-3">Lịch sử doanh thu theo từng đơn hàng</h5>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã ĐH</th>
                                        <th>Thời gian</th>
                                        <th>Khách hàng</th>
                                        <th>Phương thức</th>
                                        <th>Trạng thái</th>
                                        <th class="text-end">Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in Model.Orders)
                                    {
                                        <tr>
                                            <td><strong>#@o.OrderId</strong></td>
                                            <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@o.CustomerName</td>
                                            <td>@o.PaymentMethod</td>
                                            <td>
                                                <span class="badge @(o.OrderStatus == "Đã giao" ? "bg-success" : (o.OrderStatus == "Đã hủy" ? "bg-danger" : "bg-warning text-dark"))">
                                                    @o.OrderStatus
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold text-danger">@o.TotalAmount.ToString("N0")đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- TAB 11: QUẢN LÝ LIÊN HỆ -->
                <section id="contacts-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Quản lý liên hệ & Phản hồi khách hàng</h2>
                            <p class="text-muted mb-0">Tiếp nhận thông tin hỗ trợ và phản hồi thắc mắc</p>
                        </div>
                    </div>

                    <div class="card table-card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Khách hàng</th>
                                            <th>Email & SĐT</th>
                                            <th>Tiêu đề thắc mắc</th>
                                            <th>Nội dung</th>
                                            <th>Thời gian</th>
                                            <th>Trạng thái</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in Model.Contacts)
                                        {
                                            <tr id="contact-row-@c.ContactId">
                                                <td>#@c.ContactId</td>
                                                <td><strong>@c.FullName</strong></td>
                                                <td>
                                                    <div>@c.Email</div>
                                                    <small class="text-muted">@c.PhoneNumber</small>
                                                </td>
                                                <td class="fw-semibold text-primary">@c.Subject</td>
                                                <td>@c.Message</td>
                                                <td>@c.CreatedDate.ToString("dd/MM/yyyy")</td>
                                                <td id="contact-badge-@c.ContactId">
                                                    @if (c.IsReplied)
                                                    {
                                                        <span class="badge bg-success">Đã phản hồi</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Chưa phản hồi</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary me-1" onclick="toggleContactReply(@c.ContactId)">
                                                        Đổi trạng thái
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="xoaLienHe(@c.ContactId)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 12: CÀI ĐẶT WEBSITE -->
                <section id="settings-section" class="admin-tab-content d-none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Cài đặt website & Cửa hàng</h2>
                            <p class="text-muted mb-0">Tùy chỉnh thông tin liên hệ, mức freeship và cấu hình hệ thống</p>
                        </div>
                    </div>

                    <div class="card table-card p-4">
                        <form id="websiteSettingsForm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Tên thương hiệu / Cửa hàng</label>
                                    <input type="text" class="form-control" id="settingStoreName" value="@Model.WebsiteSettings.StoreName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Hotline chăm sóc khách hàng</label>
                                    <input type="text" class="form-control" id="settingHotline" value="@Model.WebsiteSettings.Hotline" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Email hỗ trợ</label>
                                    <input type="email" class="form-control" id="settingEmail" value="@Model.WebsiteSettings.Email" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Địa chỉ cửa hàng chính</label>
                                    <input type="text" class="form-control" id="settingAddress" value="@Model.WebsiteSettings.Address" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Đơn hàng tối thiểu miễn phí vận chuyển (VNĐ)</label>
                                    <input type="number" class="form-control" id="settingFreeShip" value="@Model.WebsiteSettings.FreeShippingThreshold" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Trạng thái website</label>
                                    <select class="form-select" id="settingIsOpen">
                                        <option value="true" @(Model.WebsiteSettings.IsStoreOpen ? "selected" : "")>Mở cửa phục vụ bình thường</option>
                                        <option value="false" @(!Model.WebsiteSettings.IsStoreOpen ? "selected" : "")>Tạm đóng cửa / Bảo trì hệ thống</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold">Thông báo thanh nổi bật (Banner Announcement)</label>
