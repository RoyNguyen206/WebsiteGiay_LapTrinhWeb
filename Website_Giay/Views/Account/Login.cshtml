@model Website_Giay.ViewModels.LoginViewModel
@{
    Layout = null;

    string loiChung = ViewData.ModelState.ContainsKey("")
        ? ViewData.ModelState[""].Errors.Select(e => e.ErrorMessage).FirstOrDefault()
        : null;

    string loiEmail = ViewData.ModelState.ContainsKey("Email")
        ? ViewData.ModelState["Email"].Errors.Select(e => e.ErrorMessage).FirstOrDefault()
        : null;

    string loiMatKhau = ViewData.ModelState.ContainsKey("Password")
        ? ViewData.ModelState["Password"].Errors.Select(e => e.ErrorMessage).FirstOrDefault()
        : null;
}
<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập | SoleStyle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="@Url.Content("~/assets/css/pages/login.css")">
</head>
<body data-page="login">

    <div class="auth-card">

        <div class="auth-header">
            <a href="@Url.Action("Index", "Home")" class="back-home">
                <i class="bi bi-arrow-left"></i> Trang chủ
            </a>
            <a href="@Url.Action("Index", "Home")" class="brand-icon">
                <i class="bi bi-shoe-print"></i> SoleStyle
            </a>
        </div>

        <div class="auth-title">
            <h1>Đăng nhập</h1>
            <p>Nhập email và mật khẩu để tiếp tục mua sắm.</p>
        </div>

        <div id="thong-bao-dang-nhap" class="thong-bao-bieu-mau @(loiChung != null ? "show error" : "")">
            <i class="bi bi-info-circle"></i>
            <span id="thong-bao-noi-dung">@loiChung</span>
        </div>

        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = Model?.ReturnUrl }, FormMethod.Post, new { id = "bieu-mau-dang-nhap", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="email-dang-nhap" class="form-label">Email</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" + (loiEmail != null ? " is-invalid" : ""), id = "email-dang-nhap", type = "email", placeholder = "you@example.com", required = "required" })
                </div>
                <div class="invalid-feedback @(loiEmail != null ? "show" : "")" id="email-feedback">@(loiEmail ?? "Vui lòng nhập email hợp lệ.")</div>
            </div>

            <div class="form-group">
                <label for="mat-khau-dang-nhap" class="form-label">Mật khẩu</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" + (loiMatKhau != null ? " is-invalid" : ""), id = "mat-khau-dang-nhap", placeholder = "••••••••", minlength = "5", required = "required" })

                </div>
                <div class="invalid-feedback @(loiMatKhau != null ? "show" : "")" id="password-feedback">@(loiMatKhau ?? "Mật khẩu tối thiểu 5 ký tự.")</div>
            </div>

            <button class="btn-login" type="submit" id="btnDangNhap">
                <span class="btn-text">Đăng nhập</span>
                <span class="spinner"></span>
            </button>
        }

        <div class="divider">HOẶC</div>
        <div class="social-login">
            <a href="#" class="social-btn"><i class="bi bi-google"></i></a>
            <a href="#" class="social-btn"><i class="bi bi-facebook"></i></a>
            <a href="#" class="social-btn"><i class="bi bi-apple"></i></a>
        </div>

        <div class="auth-footer">
            <p>Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký</a></p>
        </div>
    </div>

    <script>
        (function () {
            var form = document.getElementById("bieu-mau-dang-nhap");
            var email = document.getElementById("email-dang-nhap");
            var pwd = document.getElementById("mat-khau-dang-nhap");
            var emailFb = document.getElementById("email-feedback");
            var pwdFb = document.getElementById("password-feedback");
            var btn = document.getElementById("btnDangNhap");
            var toggleBtn = document.getElementById("togglePassword");

            function setState(input, feedback, ok) {
                input.classList.toggle("is-invalid", !ok);
                feedback.classList.toggle("show", !ok);
            }

            if (toggleBtn) {
                toggleBtn.addEventListener("click", function () {
                    var show = pwd.type === "password";
                    pwd.type = show ? "text" : "password";
                    toggleBtn.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
                });
            }

            if (form) {
                form.addEventListener("submit", function (e) {
                    var emailOk = email.value.trim() !== "" && email.checkValidity();
                    var pwdOk = pwd.value.length >= 5;
                    setState(email, emailFb, emailOk);
                    setState(pwd, pwdFb, pwdOk);
                    if (!emailOk || !pwdOk) {
                        e.preventDefault();
                        return;
                    }
                    btn.classList.add("loading");
                });
            }
        })();
    </script>
</body>
</html>
