@using Website_Giay.Models
@{
    var currentUser = Session["User"] as User;
    var cart = Session["SoleStyleCart"] as Website_Giay.ViewModels.CartViewModel;
    int cartCount = cart != null ? cart.TotalQuantity : 0;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewBag.Title != null ? ViewBag.Title + " - " : "")SoleStyle - Cửa hàng giày sneaker chính hãng</title>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- CSS Theme -->
    <link rel="stylesheet" href="@Url.Content("~/assets/css/base.css")">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/components/header.css")">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/components/footer.css")">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/components/breadcrumb.css")">

    @RenderSection("styles", required: false)
</head>
<body data-page="@(ViewBag.PageName ?? "home")" class="@(ViewBag.IsSubPage == true ? "trang-phu" : "")">

    <!-- Floating Contact & Chat AI -->
    <div class="floating-contact-wrapper">
        <a href="tel:0368068274" class="floating-contact-btn btn-phone" aria-label="Gọi điện thoại">
            <i class="bi bi-telephone-fill"></i>
            <div class="ring"></div>
            <div class="ring2"></div>
        </a>
        <a href="#" id="messenger-chat-toggle" class="floating-contact-btn btn-zalo" aria-label="Chat với AI">
            <i class="bi bi-messenger"></i>
            <div class="ring"></div>
            <div class="ring2"></div>
        </a>
    </div>

    <div id="chat-box">
        <div class="chat-header">
            <span>Chat AI Hỗ Trợ</span>
            <button id="chat-close">✖</button>
        </div>
        <iframe src="https://www.chatbase.co/chatbot-iframe/L4mRTlZojOYt5UbMKaqWi" width="100%" height="100%" frameborder="0"
                allow="clipboard-write; microphone"></iframe>
    </div>

    <!-- HEADER -->
    <header class="dau-trang-cua-hang">
        <div class="dai-loi-ich">
            <div class="container noi-dung-dai-loi-ich">
                <span><i class="bi bi-telephone-fill"></i> Hotline: 0368068274</span>
                <span><i class="bi bi-envelope-fill"></i> solestyle.cskh@gmail.com</span>
                <span><i class="bi bi-geo-alt-fill"></i> 140 Lê Trọng Tấn, Tây Thạnh, TP. Hồ Chí Minh</span>
            </div>
        </div>

        <nav id="thanh-dieu-huong" class="thanh-chinh-dau-trang navbar">
            <div class="container noi-dung-header">
                <a class="logo-cua-hang d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                    <span class="ky-hieu-logo">S</span>
                    <span>
                        SoleStyle
                        <small>Only Real</small>
                    </span>
                </a>

                <form id="bieu-mau-tim-kiem-dau-trang" class="thanh-tim-kiem" role="search" action="@Url.Action("Index", "Product")" method="get">
                    <i class="bi bi-search"></i>
                    <input id="o-tim-kiem" name="search" type="search" value="@Request.QueryString["search"]" placeholder="Tìm giày, dép, nón, phụ kiện..." aria-label="Tìm sản phẩm">
                    <button type="submit" aria-label="Tìm kiếm"><i class="bi bi-arrow-right"></i></button>
                </form>

                <div class="hanh-dong-header">
                    @if (currentUser == null)
                    {
                        <div id="hanh-dong-khach" class="nhom-tai-khoan">
                            <a class="btn btn-outline-dark nut-dang-nhap" href="@Url.Action("Login", "Account")" aria-label="Đăng nhập">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Đăng nhập</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div id="hanh-dong-nguoi-dung" class="dropdown">
                            <button class="btn btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span id="ten-nguoi-dung">@currentUser.FullName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span id="email-nguoi-dung" class="dropdown-item-text text-secondary small">@currentUser.Email</span></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Profile", "Account")"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                                @if (currentUser.Role == "Admin")
                                {
                                    <li><a class="dropdown-item text-primary" href="@Url.Action("Index", "Admin")"><i class="bi bi-speedometer2 me-2"></i>Trang quản trị</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    }

                    <button id="nut-mo-gio-hang" class="btn btn-dark position-relative nut-gio-hang" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#khung-gio-hang" aria-controls="khung-gio-hang">
                        <i class="bi bi-bag"></i>
                        <span class="chu-gio-hang ms-1">Giỏ hàng</span>
                        <span id="so-luong-gio-hang"
                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark">@cartCount</span>
                    </button>
                </div>
            </div>
        </nav>

        <nav id="thanh-danh-muc" class="thanh-dieu-huong thanh-danh-muc navbar navbar-expand-lg sticky-top">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#khung-menu"
                        aria-controls="khung-menu" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="khung-menu">
                    <ul class="navbar-nav danh-sach-danh-muc mx-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Product")">Tất cả sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Product", new { category = "Giày" })">Giày</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Product", new { category = "Dép" })">Dép</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Product", new { category = "Nón" })">Nón</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Product", new { category = "Phụ kiện" })">Phụ kiện</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")#khu-flash-deal">Ưu đãi</a></li>
                        <li class="nav-item"><a class="nav-link" href="#chan-trang">Liên hệ</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- OFFCANVAS GIỎ HÀNG -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="khung-gio-hang" aria-labelledby="tieu-de-gio-hang">
        <div class="offcanvas-header border-bottom">
            <h2 class="offcanvas-title fs-5 fw-bold" id="tieu-de-gio-hang">
                <i class="bi bi-bag me-2"></i>Giỏ hàng của bạn
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <div id="danh-sach-gio-hang" class="danh-sach-gio-hang flex-grow-1 overflow-auto">
                <!-- Dynamic render from cart session or ajax -->
            </div>
            <div class="tong-gio-hang mt-auto pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-secondary">Tạm tính:</span>
                    <strong id="tong-tien-gio-hang" class="fs-5 text-danger">0đ</strong>
                </div>
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-dark">Xem chi tiết giỏ hàng</a>
                    <a href="@Url.Action("Checkout", "Cart")" class="btn btn-dark">Tiến hành thanh toán</a>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST THÔNG BÁO NHANH -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
        <div id="thong-bao-nhanh" class="toast align-items-center text-bg-dark border-0" role="status" aria-live="polite" aria-atomic="true">
            <div class="d-flex">
                <div id="noi-dung-thong-bao" class="toast-body">Đã cập nhật.</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
            </div>
        </div>
    </div>

    <!-- NỘI DUNG CHÍNH (RENDER BODY) -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER CHUNG -->
    <footer id="chan-trang" class="chan-trang">
        <div class="dai-cam-ket-footer">
            <div class="container luoi-cam-ket">
                <div>
                    <i class="bi bi-patch-check"></i>
                    <span>Cam kết chính hãng 100%</span>
                </div>
                <div>
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Hỗ trợ đổi hàng trong 30 ngày</span>
                </div>
                <div>
                    <i class="bi bi-truck"></i>
                    <span>Giao hàng toàn quốc</span>
                </div>
                <div>
                    <i class="bi bi-headset"></i>
                    <span>Tư vấn size nhanh qua hotline</span>
                </div>
            </div>
        </div>

        <div class="container noi-dung-footer">
            <div class="cot-footer cot-thuong-hieu-footer">
                <a class="logo-cua-hang logo-footer d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                    <span class="ky-hieu-logo">S</span>
                    <span>
                        SoleStyle
                        <small>Only Real</small>
                    </span>
                </a>
                <h2>FOOTGEAR H - Only Real</h2>
                <p>
                    Chuyên giày thể thao, dép, nón và phụ kiện chính hãng. Hàng có sẵn, tư vấn đúng size, hỗ trợ kiểm tra trước khi nhận.
                </p>
                <ul class="thong-tin-cua-hang">
                    <li><i class="bi bi-building"></i> Hộ kinh doanh SoleStyle 42</li>
                    <li><i class="bi bi-geo-alt"></i> 140 Lê Trọng Tấn, Tây Thạnh, TP. Hồ Chí Minh</li>
                    <li><i class="bi bi-clock"></i> Mở cửa: 10:00 - 22:00 mỗi ngày</li>
                </ul>
                <div class="mang-xa-hoi">
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                    <a href="tel:0368068274" aria-label="Gọi hotline"><i class="bi bi-telephone-fill"></i></a>
                </div>
            </div>

            <div class="cot-footer">
                <h3>Hỗ trợ khách hàng</h3>
                <ul>
                    <li><a href="#">Chính sách kiểm hàng</a></li>
                    <li><a href="#">Chính sách vận chuyển</a></li>
                    <li><a href="#">Chính sách thanh toán</a></li>
                    <li><a href="#">Chính sách bảo hành sản phẩm</a></li>
                    <li><a href="#">Chính sách đổi trả và hoàn tiền</a></li>
                    <li><a href="#">Chính sách bảo mật</a></li>
                </ul>
            </div>

            <div class="cot-footer">
                <h3>Danh mục nổi bật</h3>
                <ul>
                    <li><a href="@Url.Action("Index", "Product", new { category = "Giày" })">Giày chính hãng</a></li>
                    <li><a href="@Url.Action("Index", "Product", new { category = "Dép" })">Dép chính hãng</a></li>
                    <li><a href="@Url.Action("Index", "Product", new { category = "Nón" })">Nón</a></li>
                    <li><a href="@Url.Action("Index", "Product", new { category = "Phụ kiện" })">Phụ kiện</a></li>
                    <li><a href="@Url.Action("Index", "Home")#khu-uu-dai">Thương hiệu</a></li>
                    <li><a href="@Url.Action("Index", "Home")#khu-flash-deal">Khuyến mãi</a></li>
                </ul>
            </div>

            <div class="cot-footer">
                <h3>Liên hệ với chúng tôi</h3>
                <ul class="thong-tin-lien-he-footer">
                    <li><i class="bi bi-telephone"></i> 0368068274</li>
                    <li><i class="bi bi-envelope"></i> solestyle.cskh@gmail.com</li>
                    <li><i class="bi bi-chat-dots"></i> Zalo / Facebook: SoleStyle</li>
                </ul>
                <div class="khung-ban-do">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.0572728099755!2d106.62625947570342!3d10.806925558629016!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752be27d8b4f4d%3A0x92dcba2950430867!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBDw7RuZyBUaMawxqFuZyBUUC4gSOG7kyBDaMOtIE1pbmggKEhVSVQp!5e0!3m2!1svi!2s!4v1781927571932!5m2!1svi!2s"
                            width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>

        <div class="chan-footer-duoi">
            <div class="container">
                <p>© @DateTime.Now.Year SoleStyle. Giày dép chính hãng cho mọi phong cách.</p>
                <span>Đang online: 42 | Tuần: 16.839 | Tổng truy cập: 1.754.442</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Theme Scripts -->
    <script src="@Url.Content("~/assets/js/data/products.js")"></script>
    <script src="@Url.Content("~/assets/js/core/common.js")"></script>

    <!-- Global Cart Offcanvas Ajax Sync -->
    <script>
        // Load cart items into offcanvas on opening
        document.addEventListener("DOMContentLoaded", function () {
            const khungGioHangEl = document.getElementById("khung-gio-hang");
            if (khungGioHangEl) {
                khungGioHangEl.addEventListener("show.bs.offcanvas", function () {
                    fetch("@Url.Action("GetCartJson", "Cart")")
                        .then(res => res.json())
                        .then(data => {
                            const container = document.getElementById("danh-sach-gio-hang");
                            const totalEl = document.getElementById("tong-tien-gio-hang");
                            const badgeEl = document.getElementById("so-luong-gio-hang");

                            if (badgeEl) badgeEl.textContent = data.totalQuantity;
                            if (totalEl) totalEl.textContent = new Intl.NumberFormat("vi-VN").format(data.totalAmount) + "đ";

                            if (!container) return;
                            if (!data.items || data.items.length === 0) {
                                container.innerHTML = '<div class="text-center py-5 text-secondary"><i class="bi bi-bag-x fs-1 d-block mb-2"></i>Giỏ hàng của bạn đang trống</div>';
                                return;
                            }

                            let html = "";
                            data.items.forEach(item => {
                                html += `
                                <div class="item-gio-hang d-flex gap-3 py-3 border-bottom align-items-center">
                                    <img src="${item.imageUrl}" alt="${item.productName}" class="rounded" style="width: 70px; height: 70px; object-fit: cover;">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 text-truncate" style="max-width: 180px;">${item.productName}</h6>
                                        <div class="small text-secondary mb-1">Màu: ${item.selectedColor} | Size: ${item.selectedSize}</div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-danger fw-bold">${new Intl.NumberFormat("vi-VN").format(item.price)}đ</span>
                                            <span class="badge bg-light text-dark border">x${item.quantity}</span>
                                        </div>
                                    </div>
                                </div>`;
                            });
                            container.innerHTML = html;
                        })
                        .catch(err => console.log("Cart load error:", err));
                });
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
