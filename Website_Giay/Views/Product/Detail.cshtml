@model Website_Giay.ViewModels.ProductDetailViewModel
@{
    ViewBag.Title = Model.Name;
    ViewBag.PageName = "product-detail";
    ViewBag.IsSubPage = true;
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/assets/css/pages/product-detail.css")">
}

<!-- BREADCRUMB -->
<nav class="product-detail-breadcrumb py-3" aria-label="Đường dẫn">
    <div class="container">
        <ol class="breadcrumb bg-transparent p-0 mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none text-secondary">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Product")" class="text-decoration-none text-secondary">Sản phẩm</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Product", new { category = Model.CategoryName })" class="text-decoration-none text-secondary">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@Model.Name</li>
        </ol>
    </div>
</nav>

<!-- MAIN PRODUCT DETAIL -->
<main class="section-trang py-4 bg-light">
    <div class="container">
        <div id="thong-bao-trang" class="alert alert-danger d-none mb-3"></div>

        <section class="detail-shell bg-white p-4 p-lg-5 rounded-4 shadow-sm" id="productDetail">
            <div class="row g-5 align-items-start">

                <!-- Ảnh sản phẩm -->
                <div class="col-lg-5">
                    <div class="gallery-wrap position-relative">
                        @if (Model.HasDiscount)
                        {
                            <span class="nhan-giam-gia position-absolute top-0 start-0 m-3 z-3 fs-6 px-3 py-2 badge bg-danger">
                                -@Model.DiscountPercent%
                            </span>
                        }
                        else if (!string.IsNullOrEmpty(Model.Badge))
                        {
                            <span class="nhan-giam-gia position-absolute top-0 start-0 m-3 z-3 fs-6 px-3 py-2 badge bg-dark">
                                @Model.Badge
                            </span>
                        }

                        <div class="main-img-box text-center bg-light rounded-4 p-3" style="min-height: 420px; display: flex; align-items: center; justify-content: center;">
                            <img id="anh-chi-tiet" src="@Url.Content(Model.ImageUrl ?? "~/assets/img/default.png")" alt="@Model.Name" class="img-fluid" style="max-height: 380px; object-fit: contain;">
                        </div>
                    </div>
                </div>

                <!-- Thông tin & Thao tác chọn -->
                <div class="col-lg-7">
                    <div class="info-panel">
                        <p id="nhan-chi-tiet" class="chu-nho text-secondary mb-2 fw-bold text-uppercase">
                            @Model.BrandName - @Model.CategoryName
                        </p>
                        <h1 id="ten-chi-tiet" class="product-title fs-3 fw-bold mb-3 text-dark">@Model.Name</h1>

                        <div class="rating-row d-flex align-items-center gap-2 mb-3 text-warning fw-medium">
                            <span class="d-flex align-items-center">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= Math.Round(Model.Rating) ? "bi-star-fill text-warning" : "bi-star text-secondary")"></i>
                                }
                            </span>
                            <span class="text-dark fw-bold ms-1">@Model.Rating.ToString("0.0")</span>
                            <span class="text-secondary small">(@Model.ReviewCount đánh giá)</span>
                        </div>

                        <div class="price-row d-flex align-items-end gap-3 mb-4 pb-3 border-bottom">
                            <strong id="gia-chi-tiet" class="price-tag fs-2 text-danger fw-bolder">@Model.Price.ToString("N0")đ</strong>
                            @if (Model.OldPrice > Model.Price && Model.OldPrice > 0)
                            {
                                <del id="gia-cu-chi-tiet" class="original-price fs-5 text-secondary mb-1">@Model.OldPrice.ToString("N0")đ</del>
                            }
                        </div>

                        <p id="mo-ta-chi-tiet" class="mo-ta-chi-tiet text-secondary mb-4 lh-lg">
                            @Model.Description
                        </p>

                        <!-- Chọn Màu Sắc -->
                        @if (Model.Colors != null && Model.Colors.Any())
                        {
                            <div class="vung-lua-chon mb-3">
                                <div class="dau-lua-chon d-flex justify-content-between mb-2">
                                    <label class="fw-bold">MÀU SẮC:</label>
                                    <span id="mau-dang-chon" class="text-primary fw-bold">@Model.Colors.First().ColorName</span>
                                </div>
                                <div id="nhom-mau-sac" class="nhom-mau-sac d-flex flex-wrap gap-2">
                                    @for (int i = 0; i < Model.Colors.Count; i++)
                                    {
                                        var c = Model.Colors[i];
                                        <button class="nut-mau-sac btn btn-outline-secondary @(i == 0 ? "dang-chon active" : "")"
                                                type="button"
                                                data-mau="@c.ColorName"
                                                data-anh="@Url.Content(c.ImageUrl ?? Model.ImageUrl)">
                                            @if (!string.IsNullOrEmpty(c.HexCode))
                                            {
                                                <span class="d-inline-block rounded-circle me-1 border" style="width: 14px; height: 14px; background-color: @c.HexCode;"></span>
                                            }
                                            @c.ColorName
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Chọn Kích Thước -->
                        @if (Model.Sizes != null && Model.Sizes.Any())
                        {
                            <div class="vung-lua-chon mb-3">
                                <div class="dau-lua-chon d-flex justify-content-between mb-2">
                                    <label class="fw-bold">KÍCH THƯỚC:</label>
                                    <span id="size-dang-chon" class="text-primary fw-bold">@Model.Sizes.First()</span>
                                </div>
                                <div id="nhom-kich-thuoc" class="nhom-kich-thuoc d-flex flex-wrap gap-2">
                                    @for (int i = 0; i < Model.Sizes.Count; i++)
                                    {
                                        var s = Model.Sizes[i];
                                        <button class="nut-kich-thuoc btn btn-outline-dark @(i == 0 ? "dang-chon active" : "")"
                                                type="button"
                                                data-size="@s">
                                            @s
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Chọn Số Lượng -->
                        <div class="vung-lua-chon mb-4">
                            <label class="form-label fw-bold mb-2">SỐ LƯỢNG:</label>
                            <div class="chon-so-luong d-inline-flex border rounded-3 overflow-hidden">
                                <button id="nut-giam-so-luong" class="btn btn-light border-0 px-3 py-2" type="button" aria-label="Giảm"><i class="bi bi-dash"></i></button>
                                <input id="so-luong-mua" class="form-control text-center border-0 fw-bold bg-white" style="width: 60px;" type="number" value="1" min="1" max="10" readonly>
                                <button id="nut-tang-so-luong" class="btn btn-light border-0 px-3 py-2" type="button" aria-label="Tăng"><i class="bi bi-plus"></i></button>
                            </div>
                        </div>

                        <div id="loi-lua-chon" class="thong-bao-loi text-danger fw-medium mb-3 d-none"></div>

                        <!-- Các nút mua hàng -->
                        <div class="action-row d-flex flex-wrap gap-3 mb-5">
                            <button id="nut-mua-ngay" class="btn btn-danger btn-lg flex-fill rounded-pill fw-bold" style="min-height: 54px;" type="button" onclick="muaNgaySanPham(@Model.Id)">
                                <i class="bi bi-lightning-charge me-2"></i> Mua ngay
                            </button>
                            <button id="nut-them-vao-gio" class="btn btn-outline-dark btn-lg flex-fill rounded-pill fw-bold" style="min-height: 54px;" type="button" onclick="themVaoGioSanPham(@Model.Id)">
                                <i class="bi bi-bag-plus me-2"></i> Thêm vào giỏ
                            </button>
                        </div>

                        <!-- Thông số kỹ thuật -->
                        <div class="accordion product-accordion" id="productAccordion">
                            <div class="accordion-item border-0 border-bottom">
                                <h2 class="accordion-header">
                                    <button class="accordion-button bg-transparent fw-bold px-0 text-dark shadow-none fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#accSpecs">
                                        <i class="bi bi-list-ul me-2"></i> Thông số kỹ thuật
                                    </button>
                                </h2>
                                <div id="accSpecs" class="accordion-collapse collapse show" data-bs-parent="#productAccordion">
                                    <div class="accordion-body px-0 pt-3 pb-4">
                                        <table class="table table-striped table-bordered spec-table mb-0">
                                            <tbody>
                                                <tr><th style="width: 35%;" class="bg-light">Thương hiệu</th><td>@Model.BrandName</td></tr>
                                                <tr><th class="bg-light">Danh mục</th><td>@Model.CategoryName</td></tr>
                                                <tr><th class="bg-light">Đối tượng</th><td>@Model.TargetAudience</td></tr>
                                                <tr><th class="bg-light">Loại sản phẩm</th><td>@Model.ProductType</td></tr>
                                                <tr><th class="bg-light">Tình trạng kho</th><td>@(Model.Stock > 0 ? $"Còn hàng ({Model.Stock} sản phẩm)" : "Tạm hết hàng")</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Đánh giá -->
                        <div class="accordion product-accordion mt-4" id="reviewAccordion">
                            <div class="accordion-item border-0 border-bottom">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed bg-transparent fw-bold px-0 text-dark shadow-none fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#accReviews">
                                        <i class="bi bi-star me-2"></i> Đánh giá từ khách hàng
                                    </button>
                                </h2>
                                <div id="accReviews" class="accordion-collapse collapse" data-bs-parent="#reviewAccordion">
                                    <div class="accordion-body px-0 pt-3 pb-4">
                                        <div class="p-3 bg-light rounded-3 mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <strong>Nguyễn Hoàng Phong</strong>
                                                <span class="text-warning"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span>
                                            </div>
                                            <p class="mb-0 text-secondary small">Giày đi rất êm chân, màu sắc đúng như hình quảng cáo. Shop giao hàng cực nhanh!</p>
                                        </div>
                                        <div class="p-3 bg-light rounded-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <strong>Trần Thị Mai</strong>
                                                <span class="text-warning"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span>
                                            </div>
                                            <p class="mb-0 text-secondary small">Đóng gói cẩn thận 2 lớp hộp, nhân viên tư vấn size chuẩn xác.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>

        <!-- SẢN PHẨM LIÊN QUAN -->
        @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
        {
            <section class="related-section mt-5 pt-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <h2 class="fs-4 fw-bold mb-0">Sản phẩm liên quan</h2>
                    <a href="@Url.Action("Index", "Product", new { category = Model.CategoryName })" class="text-decoration-none fw-medium text-dark">
                        Xem thêm <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
                <div class="luoi-san-pham">
                    @foreach (var item in Model.RelatedProducts)
                    {
                        @Html.Partial("_ProductCard", item)
                    }
                </div>
            </section>
        }
    </div>
</main>

@section scripts {
    <script src="@Url.Content("~/assets/js/pages/product-detail.js")"></script>
    <script>
        // Quantity Controls
        const qtyInput = document.getElementById("so-luong-mua");
        document.getElementById("nut-giam-so-luong")?.addEventListener("click", () => {
            let val = parseInt(qtyInput.value) || 1;
            if (val > 1) qtyInput.value = val - 1;
        });
        document.getElementById("nut-tang-so-luong")?.addEventListener("click", () => {
            let val = parseInt(qtyInput.value) || 1;
            if (val < 10) qtyInput.value = val + 1;
        });

        // Color selection
        document.querySelectorAll(".nut-mau-sac").forEach(btn => {
            btn.addEventListener("click", function () {
                document.querySelectorAll(".nut-mau-sac").forEach(b => b.classList.remove("dang-chon", "active"));
                this.classList.add("dang-chon", "active");
                const mau = this.getAttribute("data-mau");
                const anh = this.getAttribute("data-anh");
                document.getElementById("mau-dang-chon").textContent = mau;
                if (anh) {
                    document.getElementById("anh-chi-tiet").src = anh;
                }
            });
        });

        // Size selection
        document.querySelectorAll(".nut-kich-thuoc").forEach(btn => {
            btn.addEventListener("click", function () {
                document.querySelectorAll(".nut-kich-thuoc").forEach(b => b.classList.remove("dang-chon", "active"));
                this.classList.add("dang-chon", "active");
                const size = this.getAttribute("data-size");
                document.getElementById("size-dang-chon").textContent = size;
            });
        });

        function layThongTinChon() {
            const mauEl = document.getElementById("mau-dang-chon");
            const sizeEl = document.getElementById("size-dang-chon");
            const qtyEl = document.getElementById("so-luong-mua");
            return {
                color: mauEl ? mauEl.textContent.trim() : "Mặc định",
                size: sizeEl ? sizeEl.textContent.trim() : "Free size",
                quantity: qtyEl ? parseInt(qtyEl.value) || 1 : 1
            };
        }

        function themVaoGioSanPham(id) {
            const opt = layThongTinChon();
            fetch("@Url.Action("AddToCart", "Cart")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `productId=${id}&color=${encodeURIComponent(opt.color)}&size=${encodeURIComponent(opt.size)}&quantity=${opt.quantity}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Update badge
                    const badge = document.getElementById("so-luong-gio-hang");
                    if (badge) badge.textContent = data.totalQuantity;

                    // Show toast
                    const toastEl = document.getElementById("thong-bao-nhanh");
                    const msgEl = document.getElementById("noi-dung-thong-bao");
                    if (toastEl && msgEl) {
                        msgEl.textContent = "Đã thêm sản phẩm vào giỏ hàng!";
                        const toast = new bootstrap.Toast(toastEl);
                        toast.show();
                    }
                }
            })
            .catch(err => console.log(err));
        }

        function muaNgaySanPham(id) {
            const opt = layThongTinChon();
            fetch("@Url.Action("AddToCart", "Cart")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `productId=${id}&color=${encodeURIComponent(opt.color)}&size=${encodeURIComponent(opt.size)}&quantity=${opt.quantity}`
            })
            .then(res => res.json())
            .then(data => {
                window.location.href = "@Url.Action("Checkout", "Cart")";
            })
            .catch(err => {
                window.location.href = "@Url.Action("Index", "Cart")";
            });
        }
    </script>
}
