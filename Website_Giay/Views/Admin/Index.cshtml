    <script>
        // =====================================
        // CHUYỂN ĐỔI TAB SIDEBAR
        // =====================================
        function switchTab(targetId) {
            document.querySelectorAll(".admin-tab-content").forEach(el => el.classList.add("d-none"));
            document.querySelectorAll(".admin-nav-link").forEach(l => l.classList.remove("active"));

            const targetSection = document.getElementById(targetId);
            if (targetSection) {
                targetSection.classList.remove("d-none");
            }

            const activeLink = document.querySelector(`.admin-nav-link[data-target="${targetId}"]`);
            if (activeLink) {
                activeLink.classList.add("active");
            }
        }

        document.querySelectorAll(".admin-nav-link").forEach(link => {
            link.addEventListener("click", function (e) {
                const target = this.getAttribute("data-target");
                if (!target) return; // Nếu là link ngoài như AdminPromotion thì để chuyển hướng bình thường
                e.preventDefault();
                switchTab(target);
            });
        });

        // =====================================
        // 1. QUẢN LÝ ĐƠN HÀNG
        // =====================================
        function capNhatTrangThaiDonHang(orderId) {
            const select = document.getElementById(`status-select-${orderId}`);
            const status = select.value;
            fetch("@Url.Action("UpdateOrderStatus", "Admin")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `orderId=${orderId}&status=${encodeURIComponent(status)}`
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
            });
        }

        function xoaDonHang(orderId) {
            if (!confirm(`Bạn có chắc muốn hủy và xóa đơn hàng #${orderId}?`)) return;
            fetch("@Url.Action("DeleteOrder", "Admin")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `id=${orderId}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = document.getElementById(`order-row-${orderId}`);
                    if (row) row.remove();
                }
                alert(data.message);
            });
        }

        // =====================================
        // 2. QUẢN LÝ KHO HÀNG
        // =====================================
        function capNhatTonKho(productId) {
            const stockInput = document.getElementById(`inv-input-${productId}`);
            const stock = stockInput.value;
            fetch("@Url.Action("UpdateStock", "Admin")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `productId=${productId}&stock=${stock}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById(`inv-stock-val-${productId}`).innerText = data.newStock;
                    const badgeCell = document.getElementById(`inv-badge-${productId}`);
                    if (data.newStock === 0) {
                        badgeCell.innerHTML = '<span class="badge bg-danger">Hết hàng</span>';
                    } else if (data.isLowStock) {
                        badgeCell.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-bell-fill me-1"></i>Sắp hết hàng</span>';
                    } else {
                        badgeCell.innerHTML = '<span class="badge bg-success">Còn hàng</span>';
                    }
                }
                alert(data.message);
            });
        }

        // =====================================
        // 3. DANH MỤC & THƯƠNG HIỆU
        // =====================================
        document.getElementById("addCategoryForm").addEventListener("submit", function(e) {
            e.preventDefault();
            const name = document.getElementById("modalCatName").value;
