@model Website_Giay.ViewModels.OrderSuccessViewModel
@{
    ViewBag.Title = "Đặt hàng thành công";
    ViewBag.PageName = "order-success";
    ViewBag.IsSubPage = true;
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card p-4 p-md-5 rounded-4 shadow-sm border-0">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h1 class="fs-2 fw-bold text-dark mb-2">Đặt Hàng Thành Công!</h1>
                <p class="text-secondary mb-4">
                    Cảm ơn bạn đã tin tưởng mua sắm tại SoleStyle. Mã đơn hàng của bạn là 
                    <strong class="text-danger">#@Model.OrderId</strong>.
                </p>

                <div class="bg-light p-3 rounded-3 text-start mb-4">
                    <h6 class="fw-bold mb-3 border-bottom pb-2">Thông tin nhận hàng</h6>
                    <p class="mb-1"><strong>Người nhận:</strong> @Model.CustomerName</p>
                    <p class="mb-1"><strong>Số điện thoại:</strong> @Model.CustomerPhone</p>
                    <p class="mb-1"><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                    <p class="mb-1"><strong>Phương thức:</strong> @Model.PaymentMethod</p>
                    <p class="mb-0"><strong>Tổng thanh toán:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0")đ</span></p>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <a href="@Url.Action("Index", "Product")" class="btn btn-dark px-4 py-2">
                        <i class="bi bi-cart me-2"></i>Tiếp tục mua sắm
                    </a>
                    <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-dark px-4 py-2">
                        <i class="bi bi-clock-history me-2"></i>Xem lịch sử đơn hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
